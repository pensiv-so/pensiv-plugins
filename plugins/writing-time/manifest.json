{
  "$schema": "https://pensiv.so/schemas/plugin-manifest-v1.json",
  "id": "so.pensiv.writing-time",
  "name": {
    "en": "Writing Time",
    "ko": "집필 시간",
    "ja": "執筆時間"
  },
  "version": "1.0.2",
  "description": {
    "en": "Live active-writing time as a floating widget, tray chip and sheet.",
    "ko": "실제 집필 시간을 플로팅 위젯·트레이 칩·시트로 실시간 표시합니다.",
    "ja": "実際の執筆時間をフローティングウィジェット・トレイチップ・シートでリアルタイム表示します。"
  },
  "author": {
    "name": "pensiv",
    "url": "https://pensiv.so"
  },
  "icon": "Clock",
  "accent": "#327ad8",
  "sdk": "^1.0.0",
  "source": "marketplace",
  "permissions": ["session"],
  "platforms": ["desktop", "web"],
  "homepage": "https://github.com/pensiv-so/pensiv-plugins/tree/main/plugins/writing-time",
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "id": "show-today",
        "name": "Writing Time: Today's summary"
      }
    ],
    "widgets": [
      {
        "id": "writing-time",
        "surface": "floating",
        "defaultCorner": "bottom-right",
        "storageKey": "writing-time-widget"
      }
    ],
    "settings": {
      "schema": {}
    }
  }
}
