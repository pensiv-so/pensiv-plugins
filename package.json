{
  "name": "pensiv-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Public monorepo for the pensiv plugin SDK, authoring kit, and first-party plugins.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build:sdk": "tsc -b",
    "build": "npm run build:sdk && npm run build --workspaces --if-present",
    "pack-plugin": "node scripts/pack-plugin.mjs",
    "bundle-source": "node scripts/bundle-source.mjs",
    "typecheck": "npm run build:sdk && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
